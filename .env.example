# =====================================================================
#  Plantilla de variables de entorno
#  1. Copia este archivo y nómbralo .env
#  2. Cambia los valores en tu .env
#  .env NO se sube a GitHub. Este archivo sí, por eso nunca pongas
#  contraseñas reales aquí.
# =====================================================================

# --- API (Flask) ---
# Flask lee estas variables automáticamente al hacer "flask run".
FLASK_DEBUG=1
FLASK_RUN_PORT=5000

# --- Modelos ---
# Rutas desde la raíz del repo (ver "Contratos entre equipos" en el README).
# Modelo de churn del equipo de Modelos. Si se borra esta línea, la API usa un modelo de PRUEBA.
MODEL_PATH=models/telco_churn_random_forest.joblib
# De aquí sale el umbral para responder churn = true (0.460). Sin este archivo, la API no arranca.
MODEL_INFO_PATH=models/churn_model_info.json
# Segmentación K-Means (k=4): el modelo y los nombres de los segmentos.
SEGMENTS_MODEL_PATH=models/telco_customer_segments.joblib
SEGMENTS_INFO_PATH=models/segments_info.json
# Con 1, si falta un modelo la API no arranca (en vez de usar el de prueba). Útil para la demo final.
REQUIRE_MODEL=0

# --- RPA ---
# Si el bot necesita usuarios o contraseñas, agrégalos aquí con valores
# de ejemplo, y los reales solo en tu .env. Nunca dentro del código.
# RPA_USUARIO=tu_usuario
# RPA_PASSWORD=tu_password
