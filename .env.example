# =====================================================================
#  Plantilla de variables de entorno
#  1. Copia este archivo y nómbralo .env
#  2. Cambia los valores en tu .env
#  .env NO se sube a GitHub. Este archivo sí, por eso nunca pongas
#  contraseñas reales aquí.
# =====================================================================

# --- API (Flask) ---
# Flask lee estas variables automáticamente al hacer "flask run".
FLASK_DEBUG=1
FLASK_RUN_PORT=5000

# --- Modelo ---
# Nombre del archivo por definir (ver "Contratos entre equipos" en el README).
MODEL_PATH=models/modelo.pkl

# --- RPA ---
# Si el bot necesita usuarios o contraseñas, agrégalos aquí con valores
# de ejemplo, y los reales solo en tu .env. Nunca dentro del código.
# RPA_USUARIO=tu_usuario
# RPA_PASSWORD=tu_password
